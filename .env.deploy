# Settings for the public deployment (`npm run build:deploy`).
#
# The deployed site is served over HTTPS, where reaching a LAN serial proxy
# over plain ws:// is mixed content: Chrome allows it but then marks the page
# "Not secure" for the rest of the browser session, and the flag survives a
# reload. Shipping only the Web Serial transport keeps the deployed origin
# fully secure and lets the CSP tighten connect-src to 'self'.
VITE_ENABLE_PROXY=false
